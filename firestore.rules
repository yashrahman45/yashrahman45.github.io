rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is anyone with a document in /admins/{their user ID}.
    // Create the first one by hand in the Firebase console (see README).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Public catalogue. Only admins can change it.
    match /settings/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /styles/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /products/{id}   { allow read: if true; allow write: if isAdmin(); }

    // Visitors only see published reviews.
    match /reviews/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Anyone can place an order. Only admins can read or change orders.
    match /orders/{id} {
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.customer is map
        && request.resource.data.customer.name is string
        && request.resource.data.customer.name.size() < 120
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.size() < 30
        && request.resource.data.customer.addr is string
        && request.resource.data.customer.addr.size() < 500
        && request.resource.data.totals is map;
      allow read, update, delete: if isAdmin();
    }

    // Anyone can subscribe. Only admins can read the list.
    match /subscribers/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
      allow read, update, delete: if isAdmin();
    }

    // You can read your own admin record. Admins manage the list.
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
